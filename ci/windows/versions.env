# The caelestia shell and M3Shapes revisions bundle.sh builds beside
# Quickshell. Caelestia's plugin has to be the revision of the QML it is run
# with, so whoever installs the bundle should compare manifest.json against
# the caelestia checkout it stages.
CAELESTIA_REPO=https://github.com/caelestia-dots/shell
CAELESTIA_REV=fd630ffedd45eb31817e9a1726a0f567e79f65e2
CAELESTIA_VERSION=2.5.0
M3SHAPES_REPO=https://github.com/soramanew/m3shapes
M3SHAPES_REV=32ad9ce328bb77ed349b40a3be10ee9ea610b8ab
