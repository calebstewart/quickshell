diff --git a/plugin/src/Caelestia/Services/cavaprovider.cpp b/plugin/src/Caelestia/Services/cavaprovider.cpp
index dd98797b..de7073e7 100644
--- a/plugin/src/Caelestia/Services/cavaprovider.cpp
+++ b/plugin/src/Caelestia/Services/cavaprovider.cpp
@@ -2,7 +2,9 @@
 
 #include <qloggingcategory.h>
 
+#ifndef Q_OS_WIN
 #include <cava/cavacore.h>
+#endif
 
 #include <cstddef>
 
@@ -37,8 +39,12 @@ void CavaProcessor::process() {
 
     const int count = static_cast<int>(AudioCollector::instance().readChunk(m_in));
 
+#ifndef Q_OS_WIN
     // Process in data via cava
     cava_execute(m_in, count, m_out, m_plan);
+#else
+    Q_UNUSED(count);
+#endif
 
     // Apply monstercat filter
     QVector<double> values(m_bars);
@@ -84,7 +90,9 @@ void CavaProcessor::reload() {
 
 void CavaProcessor::cleanup() {
     if (m_plan) {
+#ifndef Q_OS_WIN
         cava_destroy(m_plan);
+#endif
         m_plan = nullptr;
     }
 
@@ -99,8 +107,13 @@ void CavaProcessor::initCava() {
         return;
     }
 
+#ifndef Q_OS_WIN
     m_plan = cava_init(m_bars, ac::k_sampleRate, 1, 1, 0.85, 50, 10000);
     m_out = new double[static_cast<size_t>(m_bars)];
+#else
+    // libcava is not available on Windows. Without a plan process() does nothing
+    // and the visualiser stays flat.
+#endif
 }
 
 CavaProvider::CavaProvider(QObject* parent)
