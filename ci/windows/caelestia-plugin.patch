         tickingservice.cpp
-        sensorslib.cpp
+        ${sensors_source}
         cpu.cpp
         gpu.cpp
         memory.cpp
@@ -24,10 +32,8 @@ qml_module(caelestia-services
         Qt::Concurrent
         Qt::DBus
         Qt::Network
-        PkgConfig::Pipewire
         PkgConfig::Aubio
-        PkgConfig::Cava
-        Sensors::Sensors
+        ${platform_libraries}
         caelestia-util
         caelestia-core
         caelestia-config
diff --git a/plugin/src/Caelestia/Services/audiocollector.cpp b/plugin/src/Caelestia/Services/audiocollector.cpp
index e7740961..49ef21a1 100644
--- a/plugin/src/Caelestia/Services/audiocollector.cpp
+++ b/plugin/src/Caelestia/Services/audiocollector.cpp
@@ -2,7 +2,9 @@
 
 #include <qloggingcategory.h>
 
+#ifndef Q_OS_WIN
 #include <pipewire/pipewire.h>
+#endif
 
 #include <algorithm>
 #include <mutex>
@@ -15,12 +17,15 @@
 
 namespace {
 
+#ifndef Q_OS_WIN
 Q_LOGGING_CATEGORY(lcAcWorker, "caelestia.services.ac.worker", QtInfoMsg)
+#endif
 
 } // namespace
 
 namespace caelestia::shell::services {
 
+#ifndef Q_OS_WIN
 PipeWireWorker::PipeWireWorker(std::stop_token token, AudioCollector* collector)
     : m_loop(nullptr)
     , m_stream(nullptr)
@@ -164,6 +169,8 @@ void PipeWireWorker::processStream() {
     pw_stream_queue_buffer(m_stream, buffer);
 }
 
+#endif
+
 AudioCollector& AudioCollector::instance() {
     static AudioCollector s_instance;
     return s_instance;
@@ -239,9 +246,13 @@ void AudioCollector::start() {
 
     clearBuffer();
 
+#ifndef Q_OS_WIN
     m_thread = std::jthread([this](std::stop_token token) {
         const PipeWireWorker worker(std::move(token), this);
     });
+#else
+    // There is no capture backend on Windows yet, so the buffer stays silent.
+#endif
 }
 
 void AudioCollector::stop() {
