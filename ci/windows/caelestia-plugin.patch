From b43809179f343e8cc277b47dbf6cf13887a61c23 Mon Sep 17 00:00:00 2001
From: Caleb Stewart <caleb.stewart94@gmail.com>
Date: Mon, 16 Nov 2026 22:51:11 -0500
Subject: [PATCH] build(plugin): build on Windows

Make the plugin configure, compile and link with MinGW and Qt 6 on
Windows. Other platforms are unchanged.

- PipeWire, cava and lm-sensors are not required on Windows. The audio
  collector captures nothing, the visualiser stays flat and temperatures
  read as unknown.
- The sysfs block device lookup in the storage service returns nothing.
- Shaders also emit HLSL, as Qt Quick renders through Direct3D.
- Include prefixes use directory junctions, which unlike symlinks need
  neither elevation nor developer mode.
- Every module is a static library linked into one caelestia-all DLL,
  with a small plugin DLL per module. With one DLL per module a signal's
  address differs between the DLL defining it and a DLL connecting to
  it, so connections between modules silently failed.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 plugin/CMakeLists.txt                         | 41 ++++++++++++++++---
 plugin/cmake/qml-module.cmake                 | 39 +++++++++++++++---
 plugin/src/Caelestia/Blobs/CMakeLists.txt     |  2 +-
 .../src/Caelestia/Components/CMakeLists.txt   |  2 +-
 plugin/src/Caelestia/Services/CMakeLists.txt  | 14 +++++--
 .../src/Caelestia/Services/audiocollector.cpp | 11 +++++
 .../src/Caelestia/Services/audiocollector.hpp |  4 ++
 .../src/Caelestia/Services/cavaprovider.cpp   | 13 ++++++
 .../src/Caelestia/Services/cavaprovider.hpp   |  2 +
 .../src/Caelestia/Services/sensorslib_win.cpp | 17 ++++++++
 plugin/src/Caelestia/Services/storage.cpp     |  7 ++++
 plugin/src/Caelestia/Shaders/CMakeLists.txt   |  2 +-
 12 files changed, 137 insertions(+), 17 deletions(-)
 create mode 100644 plugin/src/Caelestia/Services/sensorslib_win.cpp

diff --git a/plugin/CMakeLists.txt b/plugin/CMakeLists.txt
index 6002d8b8..68196303 100644
--- a/plugin/CMakeLists.txt
+++ b/plugin/CMakeLists.txt
@@ -1,17 +1,29 @@
 find_package(Qt6 REQUIRED COMPONENTS ShaderTools Core Qml Gui Quick QuickControls2 Concurrent Sql Network DBus Multimedia)
 find_package(PkgConfig REQUIRED)
 pkg_check_modules(Qalculate IMPORTED_TARGET libqalculate REQUIRED)
-pkg_check_modules(Pipewire IMPORTED_TARGET libpipewire-0.3 REQUIRED)
 pkg_check_modules(Aubio IMPORTED_TARGET aubio REQUIRED)
-pkg_check_modules(Cava IMPORTED_TARGET libcava QUIET)
-if(NOT Cava_FOUND)
-    pkg_check_modules(Cava IMPORTED_TARGET cava REQUIRED)
+
+# PipeWire, cava and lm-sensors do not exist on Windows. The services built on
+# them compile to stand-ins there, see src/Caelestia/Services.
+if(NOT WIN32)
+    pkg_check_modules(Pipewire IMPORTED_TARGET libpipewire-0.3 REQUIRED)
+    pkg_check_modules(Cava IMPORTED_TARGET libcava QUIET)
+    if(NOT Cava_FOUND)
+        pkg_check_modules(Cava IMPORTED_TARGET cava REQUIRED)
+    endif()
+    include(cmake/sensorslib.cmake)
 endif()
-include(cmake/sensorslib.cmake)
 
 set(QT_QML_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/qml")
 qt_standard_project_setup(REQUIRES 6.9)
 
+# Qt Quick renders through Direct3D on Windows, which needs the HLSL variants.
+if(WIN32)
+    set(CAELESTIA_SHADER_SKIP NOMSL)
+else()
+    set(CAELESTIA_SHADER_SKIP NOHLSL NOMSL)
+endif()
+
 include(cmake/pch.cmake)
 include(cmake/qml-module.cmake)
 
@@ -21,3 +33,22 @@ target_include_directories(caelestia-util INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}
 
 add_subdirectory(3rdparty/rgbcx)
 add_subdirectory(src/Caelestia)
+
+# The one DLL holding every module on Windows. See cmake/qml-module.cmake.
+if(WIN32)
+    get_property(module_targets GLOBAL PROPERTY CAELESTIA_MODULE_TARGETS)
+
+    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/caelestia_all.cpp" "// Intentionally empty.\n")
+    add_library(caelestia-all SHARED "${CMAKE_CURRENT_BINARY_DIR}/caelestia_all.cpp")
+
+    # Whole archive, as nothing in the DLL itself refers to the modules and
+    # their type registrations run from static initialisers.
+    foreach(module_target IN LISTS module_targets)
+        target_link_libraries(caelestia-all PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${module_target}>")
+    endforeach()
+
+    # Nothing is marked for export, and the plugins need the registration functions.
+    target_link_options(caelestia-all PRIVATE -Wl,--export-all-symbols)
+
+    install(TARGETS caelestia-all RUNTIME DESTINATION "${INSTALL_QMLDIR}/Caelestia/lib")
+endif()
diff --git a/plugin/cmake/qml-module.cmake b/plugin/cmake/qml-module.cmake
index 7dde2a31..1658f156 100644
--- a/plugin/cmake/qml-module.cmake
+++ b/plugin/cmake/qml-module.cmake
@@ -5,7 +5,19 @@ function(qml_module arg_TARGET)
 
     set_source_files_properties(${arg_QML_SINGLETONS} PROPERTIES QT_QML_SINGLETON_TYPE TRUE)
 
+    # On Windows every module is a static library, and all of them are linked
+    # into the single caelestia-all DLL (see plugin/CMakeLists.txt). With one
+    # DLL per module, a signal's address differs between the DLL that defines
+    # it and a DLL that connects to it, so those connections silently fail.
+    # Each module still gets its own small plugin DLL, which only pulls in
+    # caelestia-all.
+    set(module_kind)
+    if(WIN32)
+        set(module_kind STATIC PLUGIN_TARGET ${arg_TARGET}plugin NO_CREATE_PLUGIN_TARGET)
+    endif()
+
     qt_add_qml_module(${arg_TARGET}
+        ${module_kind}
         URI ${arg_URI}
         SOURCES ${arg_SOURCES}
         QML_FILES ${arg_QML_FILES} ${arg_QML_SINGLETONS}
@@ -16,6 +28,12 @@ function(qml_module arg_TARGET)
         DEFAULT_IMPORTS ${arg_DEFAULT_IMPORTS}
     )
 
+    if(WIN32)
+        qt_add_qml_plugin(${arg_TARGET}plugin URI ${arg_URI} SHARED)
+        target_link_libraries(${arg_TARGET}plugin PRIVATE caelestia-all)
+        set_property(GLOBAL APPEND PROPERTY CAELESTIA_MODULE_TARGETS ${arg_TARGET})
+    endif()
+
     qt_query_qml_module(${arg_TARGET}
         URI module_uri
         PLUGIN_TARGET module_plugin_target
@@ -34,10 +52,12 @@ function(qml_module arg_TARGET)
     set(backing_lib_dir "${INSTALL_QMLDIR}/${top_level}/lib")
     set(module_dir "${INSTALL_QMLDIR}/${module_target_path}")
 
-    install(TARGETS ${arg_TARGET}
-        LIBRARY DESTINATION "${backing_lib_dir}"
-        RUNTIME DESTINATION "${backing_lib_dir}"
-    )
+    if(NOT WIN32)
+        install(TARGETS ${arg_TARGET}
+            LIBRARY DESTINATION "${backing_lib_dir}"
+            RUNTIME DESTINATION "${backing_lib_dir}"
+        )
+    endif()
     install(TARGETS "${module_plugin_target}"
         LIBRARY DESTINATION "${module_dir}"
         RUNTIME DESTINATION "${module_dir}"
@@ -51,7 +71,16 @@ function(qml_module arg_TARGET)
     if(arg_INCLUDE_PREFIX)
         set(include_dir "${CMAKE_CURRENT_BINARY_DIR}/include")
         file(MAKE_DIRECTORY "${include_dir}")
-        file(CREATE_LINK "${CMAKE_CURRENT_SOURCE_DIR}" "${include_dir}/${arg_INCLUDE_PREFIX}" SYMBOLIC)
+        if(WIN32)
+            # Symlinks need elevation or developer mode on Windows, junctions do not.
+            if(NOT EXISTS "${include_dir}/${arg_INCLUDE_PREFIX}")
+                file(TO_NATIVE_PATH "${include_dir}/${arg_INCLUDE_PREFIX}" link_native)
+                file(TO_NATIVE_PATH "${CMAKE_CURRENT_SOURCE_DIR}" target_native)
+                execute_process(COMMAND cmd /c mklink /J "${link_native}" "${target_native}" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
+            endif()
+        else()
+            file(CREATE_LINK "${CMAKE_CURRENT_SOURCE_DIR}" "${include_dir}/${arg_INCLUDE_PREFIX}" SYMBOLIC)
+        endif()
         target_include_directories(${arg_TARGET} PUBLIC "${include_dir}")
     endif()
 
