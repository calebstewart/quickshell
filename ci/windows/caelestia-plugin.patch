index 00000000..567d6658
--- /dev/null
+++ b/plugin/src/Caelestia/Services/sensorslib_win.cpp
@@ -0,0 +1,17 @@
+#include "sensorslib.hpp"
+
+// lm-sensors does not exist on Windows. Temperatures are reported as unknown.
+
+namespace caelestia::shell::services::sensorslib {
+
+void ensureInit() {}
+
+std::optional<double> cpuPackageTemp() {
+    return std::nullopt;
+}
+
+std::optional<double> gpuPciAverageTemp() {
+    return std::nullopt;
+}
+
+} // namespace caelestia::shell::services::sensorslib
diff --git a/plugin/src/Caelestia/Services/storage.cpp b/plugin/src/Caelestia/Services/storage.cpp
index c94cb6f2..ddf53c49 100644
--- a/plugin/src/Caelestia/Services/storage.cpp
+++ b/plugin/src/Caelestia/Services/storage.cpp
@@ -8,7 +8,9 @@
 #include <qtconcurrentrun.h>
 
 #include <sys/stat.h>
+#ifndef Q_OS_WIN
 #include <sys/sysmacros.h>
+#endif
 
 #include <algorithm>
 #include <cmath>
@@ -194,6 +196,10 @@ QStringList Storage::resolveToPhysicalDisks(const QString& devicePath) {
     if (devicePath.isEmpty() || !devicePath.startsWith(u'/')) {
         return {};
     }
+#ifdef Q_OS_WIN
+    // Block devices are resolved through sysfs, which Windows does not have.
+    return {};
+#else
     struct stat st{};
     if (::stat(devicePath.toLocal8Bit().constData(), &st) != 0) {
         return {};
@@ -202,6 +208,7 @@ QStringList Storage::resolveToPhysicalDisks(const QString& devicePath) {
         return {};
     }
     return resolveByDevt(major(st.st_rdev), minor(st.st_rdev));
+#endif
 }
 
 QHash<QByteArray, Storage::DeviceEntry> Storage::collectDevices() {
